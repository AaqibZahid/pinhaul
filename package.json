{
  "name": "pinhaul",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that bulk-downloads the images and videos from a Pinterest board.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package:extension": "npm run build && node scripts/package-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:extension": "npm run build && node scripts/smoke-extension.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.4",
    "esbuild": "^0.24.0",
    "mux.js": "^6.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
