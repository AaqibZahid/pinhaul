{
  "manifest_version": 3,
  "name": "Pinpull",
  "version": "1.0.0",
  "description": "Bulk-download the images and videos from a Pinterest board into an organized folder.",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "*://pinterest.com/*",
    "*://*.pinterest.com/*",
    "*://pinterest.co.uk/*",
    "*://*.pinterest.co.uk/*",
    "*://pinterest.ca/*",
    "*://*.pinterest.ca/*",
    "*://pinterest.com.au/*",
    "*://*.pinterest.com.au/*",
    "*://pinterest.de/*",
    "*://*.pinterest.de/*",
    "*://pinterest.fr/*",
    "*://*.pinterest.fr/*",
    "*://pinterest.es/*",
    "*://*.pinterest.es/*",
    "*://pinterest.it/*",
    "*://*.pinterest.it/*",
    "*://pinterest.pt/*",
    "*://*.pinterest.pt/*",
    "*://pinterest.jp/*",
    "*://*.pinterest.jp/*",
    "*://pinterest.co.kr/*",
    "*://*.pinterest.co.kr/*",
    "*://pinterest.com.mx/*",
    "*://*.pinterest.com.mx/*",
    "*://pinterest.com.br/*",
    "*://*.pinterest.com.br/*",
    "*://pinterest.cl/*",
    "*://*.pinterest.cl/*",
    "*://pinterest.at/*",
    "*://*.pinterest.at/*",
    "*://pinterest.ch/*",
    "*://*.pinterest.ch/*",
    "*://pinterest.nz/*",
    "*://*.pinterest.nz/*",
    "*://pinterest.ie/*",
    "*://*.pinterest.ie/*",
    "*://pinterest.se/*",
    "*://*.pinterest.se/*",
    "*://pinterest.dk/*",
    "*://*.pinterest.dk/*",
    "*://pinterest.nl/*",
    "*://*.pinterest.nl/*",
    "*://pinterest.pl/*",
    "*://*.pinterest.pl/*",
    "*://pinterest.cz/*",
    "*://*.pinterest.cz/*",
    "*://pinterest.in/*",
    "*://*.pinterest.in/*",
    "*://pinterest.id/*",
    "*://*.pinterest.id/*",
    "*://*.pinimg.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pinpull",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
